# ──────────────────────────────────────────────
# BACKEND Environment Variables (set in Railway)
# ──────────────────────────────────────────────

# Django secret key — generate a new one for production!
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False for production
DEBUG=False

# Comma-separated allowed hosts (Railway domain auto-added)
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — Railway auto-injects this when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — set to your frontend Railway URL
CORS_ALLOWED_ORIGINS=https://your-frontend.railway.app

# Frontend URL
FRONTEND_URL=https://your-frontend.railway.app

# ──────────────────────────────────────────────
# FRONTEND Environment Variables (set in Railway)
# ──────────────────────────────────────────────

# Backend API URL — set to your backend Railway URL
VITE_API_URL=https://your-backend.railway.app
